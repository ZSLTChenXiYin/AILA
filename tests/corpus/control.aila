// corpus: 控制流（if / 三种 for / match / region / defer / unsafe / thread / coroutine）
import std.io;

enum Cmd { Data { v: I32 }, Eof };

coroutine func producer(tx: send chan Cmd) {
    yield;
}

func worker(cmds: recv chan Cmd) {
    region scratch: 2048 {
        let buf: [U8] = [0; 64]@scratch;
        _ = buf;
    }
}

func recv_of() -> recv chan Cmd {
    var rx: recv chan Cmd = #runtime.chan(Cmd, 4);
    return rx;
}

func control(ready: Bool, buf: [U8], n: USize) @region[r] {
    if ready {
        io.print(io.FmtVal.T { v: "yes" });
    } else if !ready {
        io.print(io.FmtVal.T { v: "no" });
    } else {
        io.print(io.FmtVal.T { v: "maybe" });
    }

    for var i: USize = 0; i < n; i = i + 1 {
        if i == 2 { continue; }
        if i > 8 { break; }
    }

    for !ready {
        break;
    }

    for {
        break;
    }

    for x in buf {
        _ = x;
    }

    for i, x in buf {
        _ = i;
        _ = x;
    }

    match n {
        0 => { io.print(io.FmtVal.T { v: "zero" }); }
        _ => { io.print(io.FmtVal.T { v: "many" }); }
    }

    let c: Cmd = Cmd.Eof;
    match c {
        .Data { v } => { io.print(io.FmtVal.I { v: #compile.as(I64, v) }); }
        .Eof => { io.print(io.FmtVal.T { v: "eof" }); }
    }

    let opt: [U8]? = None;
    match opt {
        let v: [U8] => { io.print(io.FmtVal.U { v: #compile.as(U64, #comprun.len(v)) }); }
        None => { io.print(io.FmtVal.T { v: "none" }); }
    }

    region tmp: 4096 {
        var a: [U8] = [0; 8]@tmp;
        _ = a;
    }

    unsafe {
        view words: [U32] = buf;
        _ = words;
    }

    defer io.println();
    defer {
        io.print(io.FmtVal.T { v: "done" });
    }

    #runtime.spawn(worker, recv_of());
    #runtime.trap("unreachable");
}
