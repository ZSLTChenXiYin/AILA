// AILA 标准库 · std.math（M1 最小面）
//
// 承接 designs/0001 §13.5：运算默认回绕之下的**显式回绕**出口（0004 §2.4
// 后运算符本身即回绕语义，本模块保留组合形态供查证 / 复用）。

public func wrapping_add_u32(a: U32, b: U32) -> U32 {
    let w: U64 = #compile.as(U64, a) + #compile.as(U64, b);
    return #compile.as(U32, w);
}

public func wrapping_add_i32(a: I32, b: I32) -> I32 {
    return a + b;
}

public func abs_i32(v: I32) -> I32 {
    var m: I32 = v;
    if v < 0 {
        m = 0 - v;
    }
    return m;
}

public func min_i32(a: I32, b: I32) -> I32 {
    var m: I32 = a;
    if b < a {
        m = b;
    }
    return m;
}

public func max_i32(a: I32, b: I32) -> I32 {
    var m: I32 = a;
    if b > a {
        m = b;
    }
    return m;
}

public func fmod(a: F64, b: F64) -> F64 {
    let q: F64 = a / b;
    let n: I64 = #compile.as(I64, q);
    return a - #compile.as(F64, n) * b;
}
