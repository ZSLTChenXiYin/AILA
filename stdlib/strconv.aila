// AILA 标准库 · std.strconv
//
// 批次 1（designs/0003 §3.1）：文本 ↔ 数值的纯 AILA 实现，零 #compile.c 绑定。
//
// Text 只有字面量路径、无运行时构造（§3.1 语言查证），所以格式化方向
// 一律写到调用方缓冲并返回写入字节数——不返回动态 Text、不分配。
// 解析方向：只跳**前导**空白（\t \n \v \f \r 空格），尾部空白视为非法。
//
// Err 三态：
//   - Empty：整段都是空白（或空文本）
//   - Invalid{at}：首个非法字节的下标（可能是 len，即「到头了还缺东西」）
//   - Range：数值超出目标类型范围
import std.core;

#runtime.error public enum Err { Empty, Invalid { at: USize }, Range };

// ---- 格式化（core.fill_* 直通；buf 需 ≥ 24 / 40 字节，返回写入字节数） ----

public func format_i64(v: I64, buf: [U8]) @mut[buf] -> USize {
    return core.fill_i64(v, buf);
}

public func format_u64(v: U64, buf: [U8]) @mut[buf] -> USize {
    return core.fill_u64(v, buf);
}

public func format_f64(v: F64, buf: [U8]) @mut[buf] -> USize {
    return core.fill_f64(v, buf);
}

// ---- 解析 ----

// parse_i64 解析十进制有符号整数：[ws] [+-] digits [ws]（尾空白非法）。
// 溢出检查用「acc > (max - d) / 10」整数判式，先判后乘、不回绕。
public func parse_i64(t: Text) -> I64 ! Err {
    view b: [U8] = t;
    let n: USize = #comprun.len(b);
    var i: USize = skip_ws(b, 0);
    if i == n {
        return .Empty;
    }
    var neg: Bool = false;
    if b[i] == 43 {          // '+'
        i = i + 1;
    } else if b[i] == 45 {   // '-'
        neg = true;
        i = i + 1;
    }
    if i == n {
        return .Invalid { at: i };
    }
    // I64 上界：负方向 2^63，正方向 2^63 - 1（十六进制字面量——十进制
    // 超过 I64.MAX 会落进有符号域报 E3204）
    var max: U64 = 9223372036854775807;
    if neg {
        max = 0x8000000000000000;
    }
    var acc: U64 = 0;
    for i < n {
        let d: I64 = digit_val(b[i]);
        if d < 0 {
            return .Invalid { at: i };
        }
        let dv: U64 = #compile.as(U64, d);
        if acc > (max - dv) / 10 {
            return .Range;
        }
        acc = acc * 10 + dv;
        i = i + 1;
    }
    // 负号路径走 I64 域取负（U64 的 0 - x 会回绕 trap）；
    // acc = 2^63 时 I64 取负会溢出，直接给 I64.MIN。
    if neg {
        if acc == 0x8000000000000000 {
            return -9223372036854775808;
        }
        return 0 - #compile.as(I64, acc);
    }
    return #compile.as(I64, acc);
}

// parse_u64 解析十进制无符号整数：[ws] [+] digits（'-' 非法）。
public func parse_u64(t: Text) -> U64 ! Err {
    view b: [U8] = t;
    let n: USize = #comprun.len(b);
    var i: USize = skip_ws(b, 0);
    if i == n {
        return .Empty;
    }
    if b[i] == 43 {
        i = i + 1;
    }
    if i == n {
        return .Invalid { at: i };
    }
    var acc: U64 = 0;
    for i < n {
        let d: I64 = digit_val(b[i]);
        if d < 0 {
            return .Invalid { at: i };
        }
        let dv: U64 = #compile.as(U64, d);
        if acc > (0xFFFFFFFFFFFFFFFF - dv) / 10 {
            return .Range;
        }
        acc = acc * 10 + dv;
        i = i + 1;
    }
    return acc;
}

// parse_f64 解析十进制浮点：[ws] [+-] digits [. digits] [(e|E) [+-] digits]。
// 尾数按 val*10+d 逐位累加（F64 只有 ~15.95 位有效数字，超出位只是舍入，
// M1 可接受）；指数上限 10000 钳制，乘爆 Inf 判 Range。
public func parse_f64(t: Text) -> F64 ! Err {
    view b: [U8] = t;
    let n: USize = #comprun.len(b);
    var i: USize = skip_ws(b, 0);
    if i == n {
        return .Empty;
    }
    var neg: Bool = false;
    if b[i] == 43 {
        i = i + 1;
    } else if b[i] == 45 {
        neg = true;
        i = i + 1;
    }
    if i == n {
        return .Invalid { at: i };
    }
    var mant: F64 = 0.0;
    var any: Bool = false;
    for i < n {                      // 整数部分
        let d: I64 = digit_val(b[i]);
        if d < 0 {
            break;
        }
        mant = mant * 10.0 + #compile.as(F64, d);
        any = true;
        i = i + 1;
    }
    if i < n && b[i] == 46 {         // '.' 后的小数部分
        i = i + 1;
        for i < n {
            let d: I64 = digit_val(b[i]);
            if d < 0 {
                break;
            }
            mant = mant * 10.0 + #compile.as(F64, d);
            any = true;
            i = i + 1;
            mant = mant / 10.0;      // 逐位缩回：少一次幂循环
        }
    }
    if !any {
        return .Invalid { at: i };
    }
    if i < n && (b[i] == 101 || b[i] == 69) {   // e / E 指数
        i = i + 1;
        var enorm: Bool = false;
        if i < n && b[i] == 43 {
            i = i + 1;
        } else if i < n && b[i] == 45 {
            enorm = true;
            i = i + 1;
        }
        if i == n {
            return .Invalid { at: i };
        }
        var e: U64 = 0;
        for i < n {
            let d: I64 = digit_val(b[i]);
            if d < 0 {
                return .Invalid { at: i };
            }
            e = e * 10 + #compile.as(U64, d);
            if e > 10000 {
                return .Range;
            }
            i = i + 1;
        }
        if enorm {
            for e > 0 {
                mant = mant / 10.0;
                e = e - 1;
            }
        } else {
            for e > 0 {
                mant = mant * 10.0;
                e = e - 1;
            }
        }
    }
    if i < n {
        return .Invalid { at: i };
    }
    // 乘爆成 Inf（> F64 最大值）判 Range；下溢到 0 按惯例不报错
    if mant > 1.7976931348623157e308 {
        return .Range;
    }
    if neg {
        return 0.0 - mant;
    }
    return mant;
}

// ---- 模块私有小件 ----

// skip_ws 返回 from 起第一个非空白字节下标。
func skip_ws(b: [U8], from: USize) -> USize {
    var i: USize = from;
    let n: USize = #comprun.len(b);
    for i < n {
        let c: U8 = b[i];
        if c == 9 || c == 10 || c == 11 || c == 12 || c == 13 || c == 32 {
            i = i + 1;
        } else {
            break;
        }
    }
    return i;
}

// digit_val 把 ASCII 数字转数值；非数字返回 -1。
func digit_val(c: U8) -> I64 {
    if c < 48 || c > 57 {
        return -1;
    }
    return #compile.as(I64, c) - 48;
}
