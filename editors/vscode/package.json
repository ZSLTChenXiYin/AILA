{
  "name": "aila",
  "displayName": "AILA",
  "description": "AILA 语言支持：语法高亮、括号/注释、片段、构建与运行命令",
  "version": "0.1.0",
  "publisher": "ailang",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "aila",
    "embedded",
    "region"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ailang/aila"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:aila",
    "onLanguage:aila-binding"
  ],
  "contributes": {
    "languages": [
      {
        "id": "aila",
        "aliases": [
          "AILA",
          "aila"
        ],
        "extensions": [
          ".aila"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "aila-binding",
        "aliases": [
          "AILA C 绑定（生成物）",
          "aila-binding"
        ],
        "extensions": [
          ".ail"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aila",
        "scopeName": "source.aila",
        "path": "./syntaxes/aila.tmLanguage.json"
      },
      {
        "language": "aila-binding",
        "scopeName": "source.aila.binding",
        "path": "./syntaxes/aila-binding.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "aila",
        "path": "./snippets/aila.json"
      }
    ],
    "semanticTokenScopes": [],
    "commands": [
      {
        "command": "aila.build",
        "title": "AILA: 构建（build）"
      },
      {
        "command": "aila.run",
        "title": "AILA: 构建并运行（run）"
      },
      {
        "command": "aila.check",
        "title": "AILA: 只做检查（check）"
      },
      {
        "command": "aila.doctor",
        "title": "AILA: 环境自检（doctor）"
      },
      {
        "command": "aila.bindgen",
        "title": "AILA: 生成 C 绑定（bindgen）"
      },
      {
        "command": "aila.restartLSP",
        "title": "AILA: 重启语言服务器"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "AILA",
      "properties": {
        "aila.executable": {
          "type": "string",
          "default": "aila",
          "description": "aila 可执行文件路径。留默认 `aila` 时会自动找：$AILA_HOME/bin/aila → 从工程根逐级向上找 bin/aila(.exe) → PATH"
        },
        "aila.lsp.enable": {
          "type": "boolean",
          "default": true,
          "description": "启用语言服务器（大纲 / 跳转定义 / 悬停 / 查找引用 / 诊断标红）"
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "aila",
        "required": [],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "build",
              "run",
              "check",
              "doctor"
            ],
            "default": "build"
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "smoke": "node scripts/grammar-smoke.mjs",
    "smoke:coverage": "node scripts/grammar-coverage.mjs",
    "smoke:lsp": "node scripts/lsp-smoke.mjs",
    "check": "npm run compile && npm run smoke && npm run smoke:coverage && npm run smoke:lsp",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
