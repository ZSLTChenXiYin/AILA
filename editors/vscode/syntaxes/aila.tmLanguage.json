{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AILA",
  "scopeName": "source.aila",
  "comment": "AILA 语法高亮：关键字 / 类型 / 字符串 / 数字 / 属性 / 特性子句 / 注释",
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#modulepaths" },
    { "include": "#functions" },
    { "include": "#regionblocks" },
    { "include": "#calls" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#effects" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.aila",
          "match": "//.*$"
        },
        {
          "name": "comment.block.aila",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.aila",
    "match": "#\\[[^\\]\\n]*\\]",
          "captures": {
            "0": { "name": "entity.name.function.decorator.aila" }
          }
        },
        {
          "name": "meta.builtin-query.aila",
          "match": "#(size|align)(?=\\()",
          "captures": {
            "0": { "name": "support.function.builtin.aila" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.raw.aila",
          "match": "r\"(?:[^\"\\\\]|\\\\.)*\""
        },
        {
          "name": "string.quoted.double.aila",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.aila", "match": "\\\\." }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.aila",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.aila", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.aila", "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*\\b" },
        { "name": "constant.numeric.float.aila", "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][-+]?[0-9]+)?\\b" },
        { "name": "constant.numeric.integer.aila", "match": "\\b[0-9][0-9_]*\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.aila",
          "match": "\\b(if|else|for|in|match|return|break|continue|defer|trap|yield|out|resume|move|copy|len|try)\\b"
        },
        {
          "name": "keyword.declaration.aila",
          "match": "\\b(func|struct|enum|type|let|var|const|state|view|module|import|public|coroutine|thread|as|trunc|hot|unsafe|chan|send|recv|coro)\\b"
        },
        {
          "name": "keyword.other.aila",
          "match": "\\b(self|true|false|_)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.aila",
          "match": "\\b(I8|I16|I32|I64|U8|U16|U32|U64|F32|F64|Bool|C32|Text|USize|ISize|Unsafe|Never|Void)\\b"
        },
        {
          "name": "entity.name.type.aila",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "effects": {
      "patterns": [
        {
          "name": "meta.effect-clause.aila",
          "match": "@(region|mut|move)\\b",
          "captures": {
            "0": { "name": "keyword.operator.effect.aila" }
          }
        },
        {
          "name": "variable.other.region.aila",
          "match": "@\\[\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*\\]",
          "captures": {
            "1": { "name": "entity.name.namespace.region.aila" }
          }
        },
        {
          "name": "keyword.operator.allocate.aila",
          "match": "@(static|heap)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.aila",
          "match": "(\\bfunc\\s+)(?:([A-Za-z_][A-Za-z0-9_]*)\\.)?([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.aila" },
            "2": { "name": "entity.name.type.aila" },
            "3": { "name": "entity.name.function.aila" }
          }
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "meta.function-call.aila",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.call.aila" }
          }
        }
      ]
    },
    "modulepaths": {
      "patterns": [
        {
          "name": "meta.import.aila",
          "match": "(\\bimport\\s+(?:ch|cc)?\\s*)(_|std|[A-Za-z_][A-Za-z0-9_]*)((?:\\.[A-Za-z_][A-Za-z0-9_]*)+)(\\s+as\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.control.import.aila" },
            "2": { "name": "entity.name.namespace.root.aila" },
            "3": { "name": "entity.name.namespace.aila" },
            "5": { "name": "variable.other.alias.aila" }
          }
        }
      ]
    },
    "regionblocks": {
      "patterns": [
        {
          "name": "meta.region-block.aila",
          "match": "(\\bregion\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.aila" },
            "2": { "name": "entity.name.namespace.region.aila" }
          }
        }
      ]
    }
  }
}
