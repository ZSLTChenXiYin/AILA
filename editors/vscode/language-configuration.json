{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(module(\\s+hot)?\\s*\\{|func\\b.*\\{\\s*$|struct\\b.*\\{\\s*$|enum\\b.*\\{\\s*$|region\\b.*\\{\\s*$|unsafe\\s*\\{\\s*$|match\\b.*\\{\\s*$|if\\b.*\\{\\s*$|else\\s*\\{\\s*$|for\\b.*\\{\\s*$)",
    "decreaseIndentPattern": "^\\s*\\}"
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*"
}
