// 示例 · esp8266_oled（SDK 版）：Wi-Fi + TCP 收到的文本，滚到 128×64 OLED 上
//
// 配套服务端：examples/net_console（Windows 控制台里敲中文回车发过来）。
//
// 分工（designs/0006）：
//   - `std.wifi` 走 NonOS SDK（`[sdk] = "esp8266-nosdk"`），TCP 收行；
//   - 显示走**显示栈**：`std.pixbuf` 行主序画布 + `std.textgrid` 内容模型（自动换行/滚动）
//     + `std.damage` 脏区 + `std.display.Commit`；
//   - `_.oled.panel`（AILA 协议层：命令序列 / 页窗口 / 位搬运）+ `cc _.cpacks.sw_i2c`
//     （C：GPIO 位时序）负责把 commit 发到屏上。
//
// 相对旧版的三处硬收益：
//   1. 不再手写页格式帧缓冲与 `draw_glyph` / `fb_scroll_console`——滚动是内容模型的事；
//   2. 每帧**只刷脏页**（旧版每行都 `oled_flush_all()`：整屏 1024B ≈37ms，现在通常 2 页 ≈5ms）；
//   3. 全/半角由字库 `widths` 决定，ASCII 只占 1 格——同样 128 宽能多放一倍字符。
//
// 接线（4 针模块 = VCC / GND / SCL / SDA）：VCC → 3V3，GND → GND，SCL → D1(GPIO5)，SDA → D2(GPIO4)。
// 串口 115200：`oled: i2c=1 ...` / `[wifi] 已连上` / `[tcp] 已连接服务端` / `[rx N bytes] pg=.. nack=..`
import std.core;
import std.io;
import std.wifi;
import std.time;
import std.pixbuf;
import std.damage;
import std.paint;
import std.textgrid;
import std.display;
import _.font.font16;              // 点阵字库（tools/genfont.ps1：ASCII 半角 + 汉字全角）
import _.oled.panel;              // SSD1306 协议层（AILA）
import cc _.cpacks.sw_i2c;        // 软件 I2C 传输（C：位时序 / ACK / 总线恢复）

// ---- 接线与网络 ----
const PIN_SCL: U32 = 5;   // D1
const PIN_SDA: U32 = 4;   // D2

const WIFI_SSID: Text = "ChenXiYin";
const WIFI_PASS: Text = "84170919";

// 服务端 IP：a.b.c.d → 0xAABBCCDD（这里是 192.168.1.101 = 跑 net_console 的那台 PC）
const SERVER_IP: U32 = 0xC0A80165;
const SERVER_PORT: U32 = 8266;

// ---- 屏幕几何：128×64 mono1，cell = 8×16 → 16 列 × 4 行 ----
const FB_LEN: USize = 1024; // 16 字节/行 × 64 行（行主序 + 4 字节对齐）
const SCREEN_W: U16 = 128;
const SCREEN_H: U16 = 64;
const GRID_COLS: U16 = 16;
const GRID_ROWS: U16 = 4;
const LINE_CAP: USize = 512;

module {
    func u(v: USize) -> io.FmtVal {
        return io.FmtVal.U { v: #compile.as(U64, v) };
    }

    // is_clear_cmd 判断一行是否是清屏指令（服务端发 "CLEAR"）
    func is_clear_cmd(buf: [U8], n: USize) -> Bool {
        if n != 5 {
            return false;
        }
        if buf[0] != 0x43 { return false; } // C
        if buf[1] != 0x4C { return false; } // L
        if buf[2] != 0x45 { return false; } // E
        if buf[3] != 0x41 { return false; } // A
        if buf[4] != 0x52 { return false; } // R
        return true;
    }

    func connect_wifi() -> Bool {
        wifi.mode_station();
        return wifi.connect(WIFI_SSID, WIFI_PASS);
    }

    // serve 一条连接：收字节 → 拆行 → 喂给文本网格 → 只刷脏页
    func serve(h: U64) {
        let gs: paint.GlyphSet = paint.new_glyph_set(
            font16.font_cps(), font16.font_bits(), font16.font_widths(),
            font16.font_count(), font16.font_px_h());

        region scr {
            var fbdata: [U8] = [0; FB_LEN]@scr;
            var grid_buf: [U32] = [0; textgrid.words(GRID_COLS, GRID_ROWS)]@scr;
            var dmg_buf: [U32] = [0; damage.WORDS]@scr;
            var rbuf: [U8] = [0; 128]@scr;
            var line: [U8] = [0; LINE_CAP]@scr;

            var pb: pixbuf.Pixbuf = pixbuf.new(fbdata, SCREEN_W, SCREEN_H);
            var g: textgrid.TextGrid = textgrid.new(grid_buf, GRID_COLS, GRID_ROWS);
            var d: damage.Damage = damage.new(dmg_buf);
            var c: display.Commit = display.new_commit(pb, d);
            var ln: USize = 0;

            // 连上了：屏上打个招呼（"已连接"）
            textgrid.clear(g);
            let s_ok: Text = "已连接";
            view b_ok: [U8] = s_ok;
            textgrid.put_text(g, gs, b_ok, #comprun.len(b_ok));
            damage.clear(d);
            textgrid.render_all(g, gs, pb, d);
            c.set_damage(d);
            panel.present(c);

            for {
                let n: I64 = wifi.tcp_recv(h, rbuf);
                if n < 0 {
                    return;
                }
                if n == 0 {
                    time.sleep_ms(5);
                    continue;
                }
                let got: USize = #compile.as(USize, n);
                var k: USize = 0;
                for k < got {
                    let b: U8 = rbuf[k];
                    if b == 0x0A {
                        // 一行到齐：CLEAR 清屏，否则写进网格（网格自己处理换行与滚动）
                        damage.clear(d);
                        if is_clear_cmd(line, ln) {
                            textgrid.clear(g);
                            textgrid.render_all(g, gs, pb, d);
                        } else {
                            textgrid.put_text(g, gs, line, ln);
                            textgrid.newline(g);
                            textgrid.render(g, gs, pb, d);
                        }
                        c.set_damage(d);
                        panel.present(c);
                        // 没插屏时也能从串口确认「一行到齐了」：报长度（中文按 UTF-8 字节算）
                        io.printf("[rx %u bytes] pg=%u nack=%u\n",
                            u(ln), u(#compile.as(USize, panel.pages(d))),
                            u(#compile.as(USize, panel.nack())));
                        ln = 0;
                    } else if b != 0x0D {
                        if ln < LINE_CAP {
                            line[ln] = b;
                            ln = ln + 1;
                        }
                    }
                    k = k + 1;
                }
            }
        }
    }

    func main() {
        let oled_ok: U32 = panel.init(PIN_SCL, PIN_SDA);   // 绑线 + 探地址 + 初始化序列
        io.printf("oled: i2c=%u fonts=%u\n",
            u(#compile.as(USize, oled_ok)), u(font16.font_count()));
        if oled_ok == 0 {
            // 屏没应答也别死：继续跑，串口还能看
            io.println(io.FmtVal.T { v: "[oled] 没有应答（查 SCL/SDA 接线与 0x3C 地址）" });
        }
        for {
            if !connect_wifi() {
                io.println(io.FmtVal.T { v: "[wifi] 连不上，3 秒后重试" });
                time.sleep_ms(3000);
            } else {
                io.println(io.FmtVal.T { v: "[wifi] 已连上" });
                match wifi.tcp_connect(SERVER_IP, SERVER_PORT) {
                    let h: U64 => {
                        io.println(io.FmtVal.T { v: "[tcp] 已连接服务端" });
                        serve(h);
                        wifi.tcp_close(h);
                        io.println(io.FmtVal.T { v: "[tcp] 断开，重连" });
                    },
                    let e: core.IoErr => {
                        io.println(io.FmtVal.T { v: "[tcp] 连不上服务端，3 秒后重试" });
                        _ = e;
                        time.sleep_ms(3000);
                    },
                }
            }
        }
    }
}
