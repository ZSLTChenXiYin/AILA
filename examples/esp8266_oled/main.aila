// 示例 · esp8266_oled：ESP8266 连 Wi-Fi → TCP 客户端 → 收到中文串 → 4 针 I2C OLED 显示
//
// 配套服务端：examples/net_console（Windows 控制台里敲中文回车发过来）。
//
// 硬件接线（4 针模块 = VCC / GND / SCL / SDA）：
//   OLED VCC → 3V3      OLED GND → GND
//   OLED SCL → GPIO5（NodeMCU 丝印 D1）
//   OLED SDA → GPIO4（NodeMCU 丝印 D2）
//   地址按 0x3C（多数模块）；有的模块是 0x3D，改 cpacks/ssd1306/ssd1306.c 的 OLED_ADDR。
//
// 改这三处就能用：
//   WIFI_SSID / WIFI_PASS   → 你的 Wi-Fi（这里已填 ChenXiYin / 84170919）
//   SERVER_IP               → 跑 net_console 那台 PC 的局域网 IP（形状 0xAABBCCDD）
//   SERVER_PORT             → 与服务端一致（8266）
//
// 协议（和服务端一致，极简）：一行一条消息，UTF-8 + '\n'；
// 收到一行 `CLEAR` 就清屏。屏幕上 8 列 × 4 行（每字 16x16）。
//
// 调试：所有收到的行同时从 UART0（115200）打出来，`aila run` 或串口助手都能看。
//
// 注意：本机装的是 llvm-mingw（只有 x86 后端），出 app.bin 还需要
//   ① xtensa 后端：esp-clang（注册表条目待 CI 打成 zip）
//   ② 链接器：aila toolchain install gcc/xtensa-lx106-elf
//   ③ SDK：aila toolchain install sdk/esp8266-nosdk
// 缺后端时 `aila check`（含 xtensa 目标）依然能验语义与 IR，见 README。
import std.core;
import std.io;
import std.wifi;
import std.time;
import _.font.font16;         // 16x16 点阵字库（tools/genfont.ps1 生成）
import cc _.cpacks.ssd1306;   // 只编译 C：软件 I2C + SSD1306 帧写（声明在下面手写）

// ---- SSD1306 边界（实现在 cpacks/ssd1306/ssd1306.c）----
#compile.c func oled_init(scl: U32, sda: U32) -> U32;
#compile.c func oled_cmd(b: U8);
#compile.c func oled_bind(fb: [U8]);
#compile.c func oled_flush_all();
#compile.c func oled_nack() -> U32;

// ---- 接线与网络 ----
const PIN_SCL: U32 = 5;   // D1
const PIN_SDA: U32 = 4;   // D2

const WIFI_SSID: Text = "ChenXiYin";
const WIFI_PASS: Text = "84170919";

// 服务端 IP：a.b.c.d → 0xAABBCCDD（这里是 192.168.1.101 = 跑 net_console 的这台 PC）
const SERVER_IP: U32 = 0xC0A80165;
const SERVER_PORT: U32 = 8266;

// ---- 屏幕几何：128x64，每字 16x16 ----
const COLS: U32 = 8;
const ROWS: U32 = 4;
const CELLS: U32 = 32;     // COLS * ROWS
const FB_LEN: USize = 1024; // 8 页 × 128 列
const LINE_CAP: USize = 512;

// SSD1306 初始化命令流（0xAE=关显示 … 0xAF=开显示，见 SSD1306 数据手册）
// 放在模块块里：`const` 只收编译期标量，装不下数组
module {
let INIT_CMDS: [U8; 26] = [
    0xAE,              // 关显示
    0xD5, 0x80,        // 时钟分频
    0xA8, 0x3F,        // 复用率 1/64
    0xD3, 0x00,        // 显示偏移 0
    0x40,              // 起始行 0
    0x8D, 0x14,        // 电荷泵开
    0x20, 0x00,        // 水平寻址模式
    0xA1,              // 列重映射（左右方向）
    0xC8,              // 行重映射（上下方向）
    0xDA, 0x12,        // COM 引脚配置
    0x81, 0xCF,        // 对比度
    0xD9, 0xF1,        // 预充电周期
    0xDB, 0x40,        // VCOMH
    0xA4, 0xA6,        // 显示跟随 RAM / 非反色
    0x2E,              // 关滚动
    0xAF,              // 开显示
];
    // ---------------- 帧缓冲 ----------------

    func fb_clear(fb: [U8]) @mut[fb] {
        for var i: USize = 0; i < FB_LEN; i = i + 1 {
            fb[i] = 0;
        }
    }

    // glyph_index 在字库里线性找码点（284 个字，够用；换成二分也没快多少）
    func glyph_index(cp: U32) -> I64 {
        for var i: USize = 0; i < font16.font_count(); i = i + 1 {
            if font16.font_cp(i) == cp {
                return #compile.as(I64, i);
            }
        }
        return -1;
    }

    // draw_glyph 把第 gi 号字形画到第 (col, row) 格。
    // GDDRAM 是「一个字节 8 个竖像素」，字符行号 → 页号 = row*2 + y/8，位 = y%8。
    // 字库每字 32 字节 = 16 行 × 2 字节（hi = 左半 8 列、lo = 右半 8 列），必须**逐位**落页字节，
    // 按「整字节非 0 就置位」会把字糊成实心块（oled_smoke 上踩过）。
    // gi < 0（字库没有）= 画实心方块，一眼能看出缺字。
    func draw_glyph(fb: [U8], col: U32, row: U32, gi: I64) @mut[fb] {
        if col >= COLS {
            return;
        }
        if row >= ROWS {
            return;
        }
        let x0: USize = #compile.as(USize, col) * 16;
        let page0: USize = #compile.as(USize, row) * 2;
        for var y: USize = 0; y < 16; y = y + 1 {
            var hi: U8 = 0xFF;
            var lo: U8 = 0xFF;
            if gi >= 0 {
                let base: USize = #compile.as(USize, gi) * 32 + y * 2;
                hi = font16.font_byte(base);
                lo = font16.font_byte(base + 1);
            }
            let page: USize = page0 + y / 8;
            let mask: U8 = #compile.as(U8, 1) << #compile.as(U8, y % 8);
            let at: USize = page * 128 + x0;
            for var c: USize = 0; c < 8; c = c + 1 {
                let bitc: U8 = #compile.as(U8, 0x80) >> #compile.as(U8, c);
                if hi & bitc != 0 {
                    fb[at + c] = fb[at + c] | mask;
                }
                if lo & bitc != 0 {
                    fb[at + 8 + c] = fb[at + 8 + c] | mask;
                }
            }
        }
    }

    // render 把网格里已提交的 cells 个字符重画一遍
    func render(fb: [U8], grid: [U32], cells: U32) @mut[fb] {
        fb_clear(fb);
        for var i: U32 = 0; i < cells; i = i + 1 {
            let cp: U32 = grid[#compile.as(USize, i)];
            if cp != 0 {
                let col: U32 = i % COLS;
                let row: U32 = i / COLS;
                draw_glyph(fb, col, row, glyph_index(cp));
            }
        }
        oled_bind(fb);
        oled_flush_all();
    }

    // show_msg 直接显示一行提示（连接状态用，不进网格）
    func show_msg(fb: [U8], msg: [U32], n: U32) @mut[fb] {
        fb_clear(fb);
        for var i: U32 = 0; i < n; i = i + 1 {
            draw_glyph(fb, i % COLS, i / COLS, glyph_index(msg[#compile.as(USize, i)]));
        }
        oled_bind(fb);
        oled_flush_all();
    }

    // ---------------- UTF-8 ----------------

    // utf8_next 从 buf[i] 解出下一个码点，返回 (码点, 下一个字节下标)
    func utf8_next(buf: [U8], i: USize, n: USize) -> (U32, USize) {
        let b0: U8 = buf[i];
        if b0 < 0x80 {
            return (#compile.as(U32, b0), i + 1);
        }
        if b0 < 0xE0 {
            if i + 1 >= n {
                return (0xFFFD, n);
            }
            let b1: U8 = buf[i + 1];
            let cp: U32 = (#compile.as(U32, b0) & 0x1F) << 6 | (#compile.as(U32, b1) & 0x3F);
            return (cp, i + 2);
        }
        if b0 < 0xF0 {
            if i + 2 >= n {
                return (0xFFFD, n);
            }
            let b1: U8 = buf[i + 1];
            let b2: U8 = buf[i + 2];
            let cp: U32 = (#compile.as(U32, b0) & 0x0F) << 12
                | (#compile.as(U32, b1) & 0x3F) << 6
                | (#compile.as(U32, b2) & 0x3F);
            return (cp, i + 3);
        }
        if i + 3 >= n {
            return (0xFFFD, n);
        }
        let b1: U8 = buf[i + 1];
        let b2b: U8 = buf[i + 2];
        let b3: U8 = buf[i + 3];
        let cp4: U32 = (#compile.as(U32, b0) & 0x07) << 18
            | (#compile.as(U32, b1) & 0x3F) << 12
            | (#compile.as(U32, b2b) & 0x3F) << 6
            | (#compile.as(U32, b3) & 0x3F);
        return (cp4, i + 4);
    }

    // is_clear_cmd 判一行是不是 `CLEAR`（清屏约定）
    func is_clear_cmd(buf: [U8], n: USize) -> Bool {
        if n != 5 {
            return false;
        }
        return buf[0] == 0x43   // C
            && buf[1] == 0x4C   // L
            && buf[2] == 0x45   // E
            && buf[3] == 0x41   // A
            && buf[4] == 0x52;  // R
    }

    // ---------------- 主流程 ----------------

    func oled_start() -> Bool {
        if oled_init(PIN_SCL, PIN_SDA) == 0 {
            return false;
        }
        for var i: USize = 0; i < #comprun.len(INIT_CMDS); i = i + 1 {
            oled_cmd(INIT_CMDS[i]);
        }
        return true;
    }

    func connect_wifi() -> Bool {
        wifi.mode_station();
        return wifi.connect(WIFI_SSID, WIFI_PASS);
    }

    // serve 一条连接：收字节 → 拆行 → 更新网格 → 重画
    func serve(h: U64) {
        region fbreg {
            var fb: [U8] = [0; FB_LEN]@fbreg;
            var rbuf: [U8] = [0; 128]@fbreg;
            var line: [U8] = [0; LINE_CAP]@fbreg;
            var ln: USize = 0;
            var cells: U32 = 0;
            var grid: [U32] = [0; 32]@fbreg;
            var banner: [U32] = [0; 32]@fbreg;

            // 连上了：屏上打个招呼
            banner[0] = 0x5DF2; // 已
            banner[1] = 0x8FDE; // 连
            banner[2] = 0x63A5; // 接
            banner[3] = 0;
            show_msg(fb, banner, 3);

            for {
                let n: I64 = wifi.tcp_recv(h, rbuf);
                if n < 0 {
                    show_msg(fb, banner, 0);
                    return;
                }
                if n == 0 {
                    time.sleep_ms(5);
                    continue;
                }
                let got: USize = #compile.as(USize, n);
                for var k: USize = 0; k < got; k = k + 1 {
                    let b: U8 = rbuf[k];
                    if b == 0x0A {
                        // 一行到齐：CLEAR 清屏，否则解码追加
                        if is_clear_cmd(line, ln) {
                            cells = 0;
                        } else {
                            var i: USize = 0;
                            for i < ln {
                                let (cp, ni) = utf8_next(line, i, ln);
                                if cells >= CELLS {
                                    // 满屏：丢掉最上面一行再接着写
                                    for var j: U32 = 0; j + COLS < CELLS; j = j + 1 {
                                        grid[#compile.as(USize, j)] = grid[#compile.as(USize, j + COLS)];
                                    }
                                    for var q: U32 = CELLS - COLS; q < CELLS; q = q + 1 {
                                        grid[#compile.as(USize, q)] = 0;
                                    }
                                    cells = CELLS - COLS;
                                }
                                grid[#compile.as(USize, cells)] = cp;
                                cells = cells + 1;
                                i = ni;
                            }
                        }
                        render(fb, grid, cells);
                        // 没插屏时也能从串口确认「一行到齐了」：报长度（中文按 UTF-8 字节算）
                        io.printf("[rx %u bytes]\n", io.FmtVal.U { v: #compile.as(U64, ln) });
                        ln = 0;
                    } else if b != 0x0D {
                        if ln < LINE_CAP {
                            line[ln] = b;
                            ln = ln + 1;
                        }
                    }
                }
            }
        }
    }

    func main() {
        let oled_ok: Bool = oled_start();
        if !oled_ok {
            // 屏没应答也别死：继续跑，串口还能看
            io.println(io.FmtVal.T { v: "[oled] 没有应答（查 SCL/SDA 接线与 0x3C 地址）" });
        }
        for {
            if !connect_wifi() {
                io.println(io.FmtVal.T { v: "[wifi] 连不上，3 秒后重试" });
                time.sleep_ms(3000);
            } else {
                io.println(io.FmtVal.T { v: "[wifi] 已连上" });
                match wifi.tcp_connect(SERVER_IP, SERVER_PORT) {
                    let h: U64 => {
                        io.println(io.FmtVal.T { v: "[tcp] 已连接服务端" });
                        serve(h);
                        wifi.tcp_close(h);
                        io.println(io.FmtVal.T { v: "[tcp] 断开，重连" });
                    },
                    let e: core.IoErr => {
                        io.println(io.FmtVal.T { v: "[tcp] 连不上服务端，3 秒后重试" });
                        _ = e;
                        time.sleep_ms(3000);
                    },
                }
            }
        }
    }
}
