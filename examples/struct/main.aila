// 示例 4 · struct：结构体 + 方法（类型前缀式）+ 定长内联数组字段 + 布局查询
//
// 期望输出：
//   norm2(3, 4) = 10
//   Detection{label=1 score=0.75 bbox=[1, 2, 3, 4]}
//   sizeof(Detection) = 24  align = 4
import std.io;

struct Detection {
    label: I32,
    score: F32,
    bbox: [F32; 4],
};

func Detection.norm2(self) -> I32 {
    let x: I32 = #compile.as(I32, self.bbox[0]);
    return self.label * self.label + x * x;
}

func Detection.describe(self) {
    io.printf("Detection{label=%d score=%f bbox=[",
        io.FmtVal.I { v: #compile.as(I64, self.label) },
        io.FmtVal.F { v: #compile.as(F64, self.score) });
    for i, v in self.bbox {
        if i > 0 {
            io.print(io.FmtVal.T { v: ", " });
        }
        io.print(io.FmtVal.I { v: #compile.as(I64, #compile.as(I32, v)) });
    }
    io.println(io.FmtVal.T { v: "]}" });
}

func main() {
    var d: Detection = Detection {
        label: 3,
        score: 0.75,
        bbox: [1.0, 2.0, 3.0, 4.0],
    };
    io.printf("norm2(3, 4) = %d\n", io.FmtVal.I { v: #compile.as(I64, d.norm2()) });
    d.describe();
    io.print(io.FmtVal.T { v: "sizeof(Detection) = " });
    io.print(io.FmtVal.U { v: #compile.as(U64, #compile.sizeof(Detection)) });
    io.print(io.FmtVal.T { v: "  align = " });
    io.println(io.FmtVal.U { v: #compile.as(U64, #compile.alignof(Detection)) });
}
