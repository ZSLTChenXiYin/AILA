// 示例 3 · region：区域即寿命 + 视图 + 逃逸检查
//
// 期望输出：
//   sum = 20
//   buf[0] = 7  len = 4 (bytes 16)
//   escaped region is rejected at compile time (see docs/designs/0001 §5.2)
import std.io;

// 分配点落在调用方供给的区域里：区域实参通道 `@[r]`
func fill(n: USize, v: U8) @region[r] -> [U8] {
    return [v; n]@r;
}

func sum_of(buf: [U8]) -> I32 {
    var s: I32 = 0;
    for x in buf {
        s = s + #compile.as(I32, x);
    }
    return s;
}

func main() {
    region work {
        // 分配：长度由初始化器决定，落 work
        var nums: [U8] = [5; 4]@work;
        nums[0] = 5;
        io.printf("sum = %d\n", io.FmtVal.I { v: #compile.as(I64, sum_of(nums)) });   // 20

        // 下层函数把内存分配进调用方区域 —— 跨函数寿命由区域名决定
        var buf: [U8] = fill(4, 7)@[work];
        buf[0] = 7;

        io.print(io.FmtVal.T { v: "buf[0] = " });
        io.print(io.FmtVal.I { v: #compile.as(I64, buf[0]) });
        io.print(io.FmtVal.T { v: "  len = " });
        io.print(io.FmtVal.U { v: #compile.as(U64, #comprun.len(buf)) });
        io.printf(" (bytes %u)\n", io.FmtVal.U { v: #compile.as(U64, #compile.sizeof(I32) * 4) });

        // 视图重标：等元素宽度的零拷贝出口
        let text: Text = "AILA";
        view bytes: [U8] = text;
        io.println(io.FmtVal.U { v: #compile.as(U64, #comprun.len(bytes)) });   // 4 字节
    }   // work 退出：nums / buf 整块回收，无 free、无析构
}
